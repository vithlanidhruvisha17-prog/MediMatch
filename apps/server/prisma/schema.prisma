datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Patient {
  id           String   @id @default(cuid())
  fullName     String
  phone        String
  age          Int?
  gender       String?
  city         String
  email        String   @unique
  passwordHash String   @default("")
  role         String   @default("PATIENT")
  budgetCap    Int
  createdAt    DateTime @default(now())
  assessments  Assessment[]
  inquiries    Inquiry[]
}

model Assessment {
  id                String   @id @default(cuid())
  patient           Patient  @relation(fields: [patientId], references: [id])
  patientId         String
  illnessText       String
  conditionKey      String?
  conditionDetail   String?
  durationBucket    String
  severity          Int
  symptoms          String[]
  preExisting       String[]
  medicalHistoryText String?
  aiPredictedSurgery String?
  aiPriority        String?
  aiSummary         String?
  status            String   @default("Assessed & Predicted")
  createdAt         DateTime @default(now())
}

model Hospital {
  id            String  @id @default(cuid())
  name          String
  city          String
  accreditation String
  address       String
  beds          Int
  icuBeds       Int
  imageUrl      String?
  contactEmail  String?
}

model Doctor {
  id           String @id @default(cuid())
  name         String
  specialty    String
  credentials  String
  yearsExp     Int
  fee          Int
  photoUrl     String?
  contactEmail String?
}

model Inquiry {
  id           String   @id @default(cuid())
  patient      Patient  @relation(fields: [patientId], references: [id])
  patientId    String
  hospitalId   String?
  hospitalName String?
  doctorId     String?
  doctorName   String?
  procedure    String
  status       String   @default("New")
  notes        String?
  notifyVia    String[] @default(["EMAIL"]) // new field for notification channels
  createdAt    DateTime @default(now())
}

model AIProviderConfig {
  id           String @id @default(cuid())
  provider     String
  apiKeyEnc    String
  modelName    String
  systemPrompt String
  updatedAt    DateTime @updatedAt
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  action     String
  entityType String?
  entityId   String?
  userId     String?
  userEmail  String?
  userRole   String?
  ipAddress  String?
  userAgent  String?
  status     String   @default("SUCCESS")
  details    String?
}

enum PaymentType {
  CONSULTATION
  PACKAGE_ADVANCE
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

model Payment {
  id                String        @id @default(cuid())
  type              PaymentType
  patientId         String
  doctorId          String?
  inquiryId         String?
  amount            Int           // amount in paise (smallest currency unit)
  currency          String        @default("INR")
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  razorpaySignature String?
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}
