# MediMatch Client - Environment Variables Example
# Duplicate this file as .env in production or configure these variables in your hosting provider (Render, Vercel, Netlify).

# Production Backend API Base URL (Point to your deployed Render Express backend API)
VITE_API_BASE_URL=https://medimatch-nrzs.onrender.com/api

# Alternative variable name supported by apiClient:
VITE_API_URL=https://medimatch-nrzs.onrender.com/api

# Optional: Razorpay Public Key ID for Client-side Checkout (Public Test/Live ID ONLY - NEVER put RAZORPAY_KEY_SECRET here!)
VITE_RAZORPAY_KEY_ID=rzp_test_TZ1tvtnZvTvYCk

